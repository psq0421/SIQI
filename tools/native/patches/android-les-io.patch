+// SIQI Android experiment: keep I/O workers alive across the 40 layer waves.
+// A bounded synchronous barrier preserves the original expert-install order;
+// the workers perform preadv off the compute thread, without creating hundreds
+// of pthreads for every decoded token. Prefetch uses a separate pool.
+class moe_io_pool {
+public:
+    explicit moe_io_pool(int count) {
+        if (count <= 1) return;
+        workers.reserve((size_t) count);
+        try {
+            for (int i = 0; i < count; ++i) workers.emplace_back([this] { work(); });
+        } catch (...) {
+            { std::lock_guard<std::mutex> guard(lock); stopping = true; }
+            wake.notify_all();
+            for (auto & thread : workers) thread.join();
+            throw;
+        }
+    }
+    ~moe_io_pool() {
+        { std::lock_guard<std::mutex> guard(lock); stopping = true; }
+        wake.notify_all();
+        for (auto & thread : workers) thread.join();
+    }
+    void run(int count, const std::function<void(int)> & action) {
+        if (count <= 0) return;
+        if (workers.empty() || count == 1) {
+            for (int i = 0; i < count; ++i) action(i);
+            return;
+        }
+        std::unique_lock<std::mutex> guard(lock);
+        callback = action;
+        failure = nullptr;
+        tasks = count;
+        next.store(0, std::memory_order_relaxed);
+        outstanding = (int) workers.size();
+        ++generation;
+        wake.notify_all();
+        completed.wait(guard, [this] { return outstanding == 0; });
+        callback = {};
+        if (failure) std::rethrow_exception(failure);
+    }
+private:
+    void work() {
+#ifdef __ANDROID__
+        // Optional per-worker affinity, independent of compute affinity.
+        // The kernel's cpuset/thermal policy remains authoritative.
+        if (const char * setting = std::getenv("SIQI_MOE_IO_CPU_MASK")) {
+            const unsigned long long mask = std::strtoull(setting, nullptr, 0);
+            cpu_set_t cores; CPU_ZERO(&cores);
+            for (int i = 0; i < CPU_SETSIZE && i < 64; ++i) if (mask & (1ULL << i)) CPU_SET(i, &cores);
+            if (mask) sched_setaffinity(0, sizeof(cores), &cores);
+        }
+#endif
+        uint64_t observed = 0;
+        for (;;) {
+            std::unique_lock<std::mutex> guard(lock);
+            wake.wait(guard, [this, observed] { return stopping || generation != observed; });
+            if (stopping) return;
+            observed = generation;
+            const int count = tasks;
+            const auto action = callback;
+            guard.unlock();
+            for (;;) {
+                const int index = next.fetch_add(1, std::memory_order_relaxed);
+                if (index >= count) break;
+                try { action(index); }
+                catch (...) {
+                    std::lock_guard<std::mutex> error_guard(lock);
+                    if (!failure) failure = std::current_exception();
+                }
+            }
+            guard.lock();
+            if (--outstanding == 0) completed.notify_one();
+        }
+    }
+    std::mutex lock;
+    std::condition_variable wake, completed;
+    std::vector<std::thread> workers;
+    std::function<void(int)> callback;
+    std::exception_ptr failure;
+    std::atomic<int> next{0};
+    int tasks = 0, outstanding = 0;
+    uint64_t generation = 0;
+    bool stopping = false;
+};
+
+static bool persistent_io_enabled() {
+    const char * setting = std::getenv("SIQI_MOE_PERSISTENT_IO");
+    return !setting || setting[0] != '0';
+}
