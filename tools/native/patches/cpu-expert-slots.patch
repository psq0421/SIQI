+// SIQI Android LES port: a distinct host buffer type forces expert slots to
+// own writable memory rather than aliasing the read-only model mmap.
+static const char * ggml_backend_cpu_alloc_only_name(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return "CPU_ExpertSlots";
+}
+
+#ifdef __ANDROID__
+// Opt-in research buffer. MAP_FIXED is permitted ONLY inside this independently
+// reserved arena, never inside malloc memory or a read-only GGUF mapping.
+struct siqi_expert_arena { void * base; size_t length; };
+static std::atomic<uint64_t> siqi_expert_mapped_ranges{0}, siqi_expert_mapped_bytes{0};
+static void siqi_expert_mapping_stats(uint64_t * ranges, uint64_t * bytes) {
+    if (ranges) *ranges = siqi_expert_mapped_ranges.load(std::memory_order_relaxed);
+    if (bytes) *bytes = siqi_expert_mapped_bytes.load(std::memory_order_relaxed);
+}
+
+static size_t siqi_expert_page_size() {
+    const long result = sysconf(_SC_PAGESIZE);
+    return result > 0 ? (size_t) result : 0;
+}
+static size_t siqi_expert_aligned_size(size_t size) {
+    const size_t page = siqi_expert_page_size();
+    if (!page || size > std::numeric_limits<size_t>::max() - page + 1) return 0;
+    return ((size + page - 1) / page) * page;
+}
+static void * siqi_expert_base(ggml_backend_buffer_t buffer) {
+    return static_cast<siqi_expert_arena *>(buffer->context)->base;
+}
+static void siqi_expert_free(ggml_backend_buffer_t buffer) {
+    auto * arena = static_cast<siqi_expert_arena *>(buffer->context);
+    munmap(arena->base, arena->length);
+    delete arena;
+}
+static void siqi_expert_set(ggml_backend_buffer_t, ggml_tensor * tensor,
+        const void * data, size_t offset, size_t length) {
+    memcpy(static_cast<char *>(tensor->data) + offset, data, length);
+}
+static void siqi_expert_get(ggml_backend_buffer_t, const ggml_tensor * tensor,
+        void * data, size_t offset, size_t length) {
+    memcpy(data, static_cast<const char *>(tensor->data) + offset, length);
+}
+static void siqi_expert_memset(ggml_backend_buffer_t, ggml_tensor * tensor,
+        uint8_t value, size_t offset, size_t length) {
+    memset(static_cast<char *>(tensor->data) + offset, value, length);
+}
+static void siqi_expert_clear(ggml_backend_buffer_t buffer, uint8_t value) {
+    auto * arena = static_cast<siqi_expert_arena *>(buffer->context);
+    void * fresh = mmap(arena->base, arena->length, PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    if (fresh == MAP_FAILED) throw std::runtime_error("expert-arena-reset-failed");
+    // Anonymous pages already contain zero. Do not fault in gigabytes on reset.
+    if (value) memset(fresh, value, arena->length);
+}
+static ggml_backend_buffer_t siqi_expert_allocate(ggml_backend_buffer_type_t type, size_t size) {
+    const size_t length = siqi_expert_aligned_size(size);
+    if (!length) return nullptr;
+    void * base = mmap(nullptr, length, PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED) return nullptr;
+    auto * arena = new (std::nothrow) siqi_expert_arena{base, length};
+    if (!arena) { munmap(base, length); return nullptr; }
+    ggml_backend_buffer_i iface{};
+    iface.free_buffer = siqi_expert_free; iface.get_base = siqi_expert_base;
+    iface.set_tensor = siqi_expert_set; iface.get_tensor = siqi_expert_get;
+    iface.memset_tensor = siqi_expert_memset; iface.clear = siqi_expert_clear;
+    return ggml_backend_buffer_init(type, iface, arena, length);
+}
+static size_t siqi_expert_alignment(ggml_backend_buffer_type_t) { return siqi_expert_page_size(); }
+static size_t siqi_expert_tensor_size(ggml_backend_buffer_type_t, const ggml_tensor * tensor) {
+    return siqi_expert_aligned_size(ggml_nbytes(tensor));
+}
+// Returns false ONLY before mapping. A mapping failure is fatal to this request,
+// since silently falling back to preadv could write into an already read-only slot.
+static bool siqi_expert_map_readonly(ggml_backend_buffer_t buffer, void * address,
+        size_t length, int fd, uint64_t offset, bool validate_only) {
+    if (!buffer || buffer->iface.free_buffer != siqi_expert_free) return false;
+    const auto * arena = static_cast<const siqi_expert_arena *>(buffer->context);
+    const size_t page = siqi_expert_page_size();
+    const uintptr_t start = reinterpret_cast<uintptr_t>(address);
+    const uintptr_t base = reinterpret_cast<uintptr_t>(arena->base);
+    if (!page || !length || start % page || length % page || offset % page ||
+        start < base || start - base > arena->length || length > arena->length - (start - base) ||
+        offset > (uint64_t) std::numeric_limits<off_t>::max() ||
+        length > (uint64_t) std::numeric_limits<off_t>::max() - offset) return false;
+    struct stat info{};
+    if (fstat(fd, &info) || info.st_size < 0 || offset + length > (uint64_t) info.st_size) return false;
+    if (validate_only) return true;
+    void * mapped = mmap(address, length, PROT_READ, MAP_PRIVATE | MAP_FIXED, fd, (off_t) offset);
+    if (mapped == MAP_FAILED || mapped != address) throw std::runtime_error("expert-slot-mmap-failed");
+    madvise(mapped, length, MADV_WILLNEED);
+    // Complete page-in on the I/O worker, not on the later CPU matmul. These
+    // pages are clean/file-backed and reclaimable, unlike copied quant weights.
+    const volatile uint8_t * bytes = static_cast<const volatile uint8_t *>(mapped);
+    uint8_t sink = 0;
+    for (size_t index = 0; index < length; index += page) sink ^= bytes[index];
+    GGML_UNUSED(sink);
+    siqi_expert_mapped_ranges.fetch_add(1, std::memory_order_relaxed);
+    siqi_expert_mapped_bytes.fetch_add(length, std::memory_order_relaxed);
+    return true;
+}
+static const char * siqi_expert_mapped_name(ggml_backend_buffer_type_t) { return "CPU_ExpertSlotsMapped"; }
+#endif
+
+static ggml_backend_buffer_type_t ggml_backend_cpu_alloc_only(size_t index) {
+    if (index != 0) return nullptr;
+    static ggml_backend_buffer_type type = [] {
+        ggml_backend_buffer_type copy = *ggml_backend_cpu_buffer_type();
+        copy.iface.get_name = ggml_backend_cpu_alloc_only_name;
+        copy.device = ggml_backend_reg_dev_get(ggml_backend_cpu_reg(), 0);
+        return copy;
+    }();
+#ifdef __ANDROID__
+    const char * setting = std::getenv("SIQI_MOE_MMAP_SLOTS");
+    if (setting && setting[0] == '1') {
+        static ggml_backend_buffer_type mapped = [] {
+            auto copy = type;
+            copy.iface.get_name = siqi_expert_mapped_name;
+            copy.iface.alloc_buffer = siqi_expert_allocate;
+            copy.iface.get_alignment = siqi_expert_alignment;
+            copy.iface.get_alloc_size = siqi_expert_tensor_size;
+            return copy;
+        }();
+        return &mapped;
+    }
+#endif
+    return &type;
+}
