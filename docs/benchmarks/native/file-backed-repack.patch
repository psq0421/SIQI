+// Experimental opt-in: file-backed repack storage, not Android swap tuning.
+// Unlink immediately; the kernel reclaims storage on unmap or process exit.
+static void siqi_repack_unmap(ggml_backend_buffer_t buffer) {
+    munmap(buffer->context, buffer->size);
+}
+static ggml_backend_buffer_t siqi_repack_file_buffer(size_t size) {
+    const char * directory = getenv("SIQI_REPACK_CACHE_DIR");
+    if (!directory || !*directory || size < 64 * 1024 * 1024) return nullptr;
+    struct statvfs volume{};
+    if (statvfs(directory, &volume) != 0 ||
+        static_cast<uint64_t>(volume.f_bavail) * volume.f_frsize < size + 1024ULL * 1024 * 1024) {
+        GGML_LOG_ERROR("SIQI repack: insufficient scratch storage\n");
+        return nullptr;
+    }
+    std::string pattern = std::string(directory) + "/siqi-repack-XXXXXX";
+    std::vector<char> name(pattern.begin(), pattern.end());
+    name.push_back('\0');
+    int fd = mkstemp(name.data());
+    if (fd < 0) return nullptr;
+    unlink(name.data());
+    if (ftruncate(fd, size) != 0) { close(fd); return nullptr; }
+    void * data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (data == MAP_FAILED) return nullptr;
+    auto buffer = ggml_backend_cpu_buffer_from_ptr(data, size);
+    if (!buffer) { munmap(data, size); return nullptr; }
+    buffer->iface.free_buffer = siqi_repack_unmap;
+    GGML_LOG_INFO("SIQI repack: file-backed scratch buffer %zu bytes\n", size);
+    return buffer;
+}
+#endif
